    "test:static": "node --test --test-reporter=spec static.test.js",
    "test:protocol": "node --test --test-reporter=spec protocol.test.js",
    "test:app": "node --test --test-reporter=spec --test-timeout=120000 app.test.js"
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
